# 本仓库 Vue CLI 调试页的公共默认值，所有 mode 都会加载。
# 安装组件库的业务项目使用自身 env，不会自动加载本仓库的配置。
# 同名变量优先级（高到低）：启动进程已有变量 > .env.[mode].local
# > .env.[mode] > .env.local > .env。修改后需重启开发服务。

# 静态资源公共路径；开发服务固定为 /，正式构建可由 .env.production 覆盖。
VUE_APP_STATIC_PATH=/

# HTTP 开发代理：0 直连服务，1 经本地开发服务器转发。
# 仅 NODE_ENV=development 生效；本机开发开关放在 .env.development.local。
# 请求器与 vue.config.js 共用服务地址，不需要再手写各服务的 proxy target。
VUE_APP_PROXY_ENABLE=0

# Vue CLI 调试页端口；本机可在 .env.local 覆盖，Storybook 使用独立端口。
VUE_APP_DEV_PORT=3800
