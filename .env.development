# npm run dev / npm run debug：加载此文件，NODE_ENV 由 Vue CLI 设为 development。
# 默认连接远程开发环境；本地后端地址写入 .env.development.local。
# 服务地址只写协议、域名和端口，请求器会追加各服务的 API 前缀。

# 统一服务网关：UC、Titan、CMS、Admin、ERP 未单独配置时使用此地址。
# 如需单独指定，使用 VUE_APP_UC_API / VUE_APP_TITAN_API / VUE_APP_CMS_API 等。
VUE_APP_SERVICE_API=https://service.dev.deepberry.cn/

# 独立服务的 HTTP 地址，优先于 VUE_APP_SERVICE_API；不配置 WebSocket 连接。
VUE_APP_IO_API=https://dev.io.deepberry.cn
VUE_APP_NEXT_API=https://dev.next.deepberry.cn/
VUE_APP_PAY_API=https://dev.pay.deepberry.cn/
