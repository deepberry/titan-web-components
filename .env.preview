# npm run preview：加载此文件，以开发服务器连接预览环境。
# preview 是自定义 mode，当前脚本下 NODE_ENV 仍为 development，不是正式构建。
# 服务地址只写协议、域名和端口，请求器自动追加 API 前缀。

# 预览环境的统一服务网关：UC、Titan、CMS、Admin、ERP 默认使用此地址。
VUE_APP_SERVICE_API=https://service.preview.deepberry.cn/

# Next 使用预览环境；IO、支付目前沿用正式服务地址。
VUE_APP_IO_API=https://io.deepberry.cn
VUE_APP_NEXT_API=https://preview.next.deepberry.cn/
VUE_APP_PAY_API=https://pay.deepberry.cn/
