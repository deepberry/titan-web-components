# npm run build：加载此文件，生成正式构建（NODE_ENV=production，不使用开发代理）。
# npm run serve：也加载此文件，但脚本显式设为 NODE_ENV=development，方便本地连接正式服务。
# 服务地址只写协议、域名和端口，请求器自动追加 API 前缀。

# 正式环境统一网关：UC、Titan、CMS、Admin、ERP 默认使用此地址。
VUE_APP_SERVICE_API=https://service.deepberry.cn/

# 独立服务的正式 HTTP 地址，优先于 VUE_APP_SERVICE_API。
VUE_APP_IO_API=https://io.deepberry.cn
VUE_APP_NEXT_API=https://next.deepberry.cn/
VUE_APP_PAY_API=https://pay.deepberry.cn/

# 正式构建的静态资源 CDN 路径；npm run serve 的本地静态资源仍从 / 加载。
VUE_APP_STATIC_PATH=https://cdn.deepberry.cn/static/titan/
